guid: 7e2dfb77-be1a-49d0-8fbb-a61b53141b5b
model:
  name: Banking_Model
  description: The Banking_Model worksheet provides a comprehensive overview of customer transactions and personal details. It includes information on customer demographics such as location, contact details, and employment, as well as financial data including annual income, transaction details, and risk assessments. This worksheet is instrumental in analyzing customer behavior, assessing financial risks, and maintaining up-to-date records of banking transactions. (AI generated)
  model_tables:
  - name: BANK_CUSTOMER_CONTACT_DETAILS
    fqn: 966d5d76-eda0-4719-861a-aa1077f3bdf1
    joins:
    - with: BANKING_CUSTOMERS
      referencing_join: FK_CUSTOMER_ID
  - name: BANK_TRANSACTIONS
    fqn: 105d33d5-6fed-452f-9cea-c30e8bdea534
    joins:
    - with: BANKING_CUSTOMERS
      referencing_join: FK_CUSTOMER_ID
  - name: BANKING_CUSTOMERS
    fqn: 998bcfde-064f-49b7-ac93-34739cc08dcf
  formulas:
  - id: formula_Full_Name
    name: Full_Name
    expr: concat ( [BANKING_CUSTOMERS::FIRST_NAME] , ' ' , [BANKING_CUSTOMERS::LAST_NAME] )
  columns:
  - name: Full Name
    formula_id: formula_Full_Name
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
  - name: Age
